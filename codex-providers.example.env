# Codex provider secrets.
# Copy this file to ~/.codex-providers.env and fill in your API keys.
#   cp codex-providers.example.env ~/.codex-providers.env
#   chmod 600 ~/.codex-providers.env
#
# This file is sourced by codex-use.sh.
#
# IMPORTANT: Codex uses OpenAI Responses API, but DeepSeek/Zhipu only support
# Chat Completions. A local proxy (chat-proxy.mjs) auto-starts on first use
# to translate between the two protocols. The base URLs below point to the
# local proxy. The proxy reads API keys from this file.

# ── DeepSeek ────────────────────────────────────────────────
CODEX_DEEPSEEK_API_KEY=''
CODEX_DEEPSEEK_BASE_URL='http://127.0.0.1:8788/v1'
CODEX_DEEPSEEK_MODEL='deepseek-v4-pro'

# ── Zhipu BigModel (智谱 GLM) ──────────────────────────────
CODEX_ZHIPU_API_KEY=''
CODEX_ZHIPU_BASE_URL='http://127.0.0.1:8789/v1'
CODEX_ZHIPU_MODEL='glm-5.1'
